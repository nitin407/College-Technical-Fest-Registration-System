@model List<Participant>
@{
    ViewData["Title"] = "Participants";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - College Fest</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1>AMTICS Technical Fest</h1><p class="text-muted">Registered Participants</p></div>
        <div>
            <a asp-action="Welcome" class="btn btn-outline-primary">Welcome</a>
            <a asp-action="Register" class="btn btn-primary">Register</a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">No participants registered yet.</div>
    }
    else
    {
        <div class="table-responsive bg-white shadow-sm rounded">
        <table class="table table-bordered table-hover mb-0">
            <thead class="table-dark">
                <tr><th>ID</th><th>Name</th><th>Email</th><th>Department</th><th>Year</th><th>Event</th><th>Status</th><th>Fee</th><th>Action</th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.ParticipantId</td><td>@p.ParticipantName</td><td>@p.Email</td><td>@p.Department</td><td>@p.Year</td><td>@p.EventName</td>
                    <td>
                        @if (p.GetRegistrationStatus() == "Confirmed") { <span class="badge bg-success">@p.GetRegistrationStatus()</span> }
                        else { <span class="badge bg-warning text-dark">@p.GetRegistrationStatus()</span> }
                    </td>
                    <td>₹@(p.RegistrationFee ?? 0) <small class="text-muted">(@p.GetFeeCategory())</small></td>
                    <td><a asp-action="Details" asp-route-id="@p.ParticipantId" class="btn btn-sm btn-info">Details</a></td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</div>
</body>
</html>
