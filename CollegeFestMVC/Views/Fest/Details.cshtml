@model Participant
<!DOCTYPE html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Details - College Fest</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light"><div class="container py-5"><div class="card shadow mx-auto" style="max-width:700px"><div class="card-body p-4"><h2>Participant Details</h2><div class="alert alert-success mt-3"><strong>Welcome, @Model.ParticipantName!</strong><br/>You are registered for <strong>@Model.EventName</strong>.</div>
@if (Model.GetRegistrationStatus() == "Confirmed") { <div class="alert alert-success">Registration Confirmed</div> } else { <div class="alert alert-warning">Registration Pending</div> }
<table class="table"><tr><th>ID</th><td>@Model.ParticipantId</td></tr><tr><th>Name</th><td>@Model.ParticipantName</td></tr><tr><th>Email</th><td>@Model.Email</td></tr><tr><th>Department</th><td>@Model.Department</td></tr><tr><th>Year</th><td>@Model.Year</td></tr><tr><th>Event</th><td>@Model.EventName</td></tr><tr><th>Team Event</th><td>@(Model.IsTeamEvent ? "Yes" : "No")</td></tr><tr><th>Fee</th><td>₹@(Model.RegistrationFee ?? 0)</td></tr><tr><th>Fee Category</th><td>@Model.GetFeeCategory()</td></tr></table><a asp-action="Index" class="btn btn-primary">Back to Participants</a></div></div></div></body></html>
